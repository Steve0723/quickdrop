# 复制为 .env 后按需修改： cp .env.example .env

# 宿主机端口
QD_PORT=6026

# 数据目录：db.json 与上传的文件都在这里
# 相对路径相对于 docker-compose.yml；也可以写绝对路径，如 /mnt/disk/quickdrop
QD_DATA_DIR=./data

# 初始管理员（仅首次启动生效；密码留空则随机生成并写入 data/admin-credentials.txt）
QD_ADMIN_USER=admin
QD_ADMIN_PASSWORD=

# 访问令牌签名密钥，留空则自动生成并持久化到 db.json
QD_SECRET=

# 有效期（小时）
QD_DEFAULT_TTL_HOURS=24
QD_MAX_TTL_HOURS=720

# 上传限制
QD_MAX_FILE_MB=200
QD_MAX_SHARE_MB=500
QD_MAX_FILES=10

# 登录状态保留天数
QD_SESSION_DAYS=7
